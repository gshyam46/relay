# Relay — environment configuration
#
# Copy to `.env` for local development, then just `npm start` — every script
# loads `.env` automatically via --env-file-if-exists.
#
# Put secrets here rather than on a command line, so they stay out of shell
# history and out of any transcript.
#
# In staging and production these are set as platform environment variables /
# secrets (Render dashboard, GitHub Actions secrets) and this file is only the
# reference for WHICH variables exist. Never commit a filled-in .env — `.env` is
# gitignored; `.env.example` is not, so keep real values out of this file.

# ---------------------------------------------------------------------------
# Runtime
# ---------------------------------------------------------------------------
# development (default) | staging | production
# staging and production additionally REQUIRE DATABASE_URL, force Secure session
# cookies, trust X-Forwarded-Proto, and switch logs to JSON.
NODE_ENV=development
PORT=3000

# ---------------------------------------------------------------------------
# Database
# ---------------------------------------------------------------------------
# Leave DATABASE_URL unset to use SQLite (local development and the test suite).
# DATABASE_FILE only applies to SQLite.
DATABASE_FILE=data/app.db

# Set DATABASE_URL to switch to PostgreSQL. This is the only switch — no code or
# build flag changes. For Supabase use the CONNECTION POOLER string (port 6543)
# for the app; the direct string (port 5432) is for migrations and psql.
#   DATABASE_URL=postgresql://postgres.<ref>:<password>@aws-0-<region>.pooler.supabase.com:6543/postgres
# DATABASE_URL=

# TLS is on by default for PostgreSQL. Set to `disable` only for a plain local
# Postgres container.
# DATABASE_SSL=disable
# DATABASE_MAX_CONNECTIONS=10
# DATABASE_CONNECTION_TIMEOUT_MS=10000

# ---------------------------------------------------------------------------
# Logging
# ---------------------------------------------------------------------------
# debug | info | warn | error   (default: debug locally, info when deployed)
# LOG_LEVEL=info
# json | text                   (default: json when deployed, text locally)
# LOG_FORMAT=json

# ---------------------------------------------------------------------------
# Security
# ---------------------------------------------------------------------------
# Trust X-Forwarded-Proto to decide whether a request arrived over HTTPS. Only
# enable where a proxy you control (Render, a load balancer) sets that header —
# a direct client could otherwise claim HTTPS and be issued a Secure cookie over
# plaintext. Defaults to on in staging/production, off locally.
# TRUST_PROXY=true
# Always mark session cookies Secure, regardless of how the request arrived.
# FORCE_SECURE_COOKIES=true

# ---------------------------------------------------------------------------
# Background worker
# ---------------------------------------------------------------------------
# The in-process loop that executes approved outbound actions. Disable it on any
# instance that should only serve HTTP (for example if the worker is later split
# into its own Render service, so that two instances do not both execute).
# WORKER_ENABLED=true
# WORKER_INTERVAL_MS=5000

# ---------------------------------------------------------------------------
# AI provider (optional)
# ---------------------------------------------------------------------------
# Without these, Relay uses its deterministic local agents and stays fully
# functional. Supported: groq | openai | openrouter | ollama
# LLM_PROVIDER=groq
# LLM_MODEL=
# GROQ_API_KEY=
# OPENAI_API_KEY=
# OPENROUTER_API_KEY=

# ---------------------------------------------------------------------------
# Test-only
# ---------------------------------------------------------------------------
# `npm run test:pg` runs the WHOLE suite against PostgreSQL. It uses
# TEST_DATABASE_URL if set, otherwise DATABASE_URL above — so for staging you
# usually need neither of these.
#
# Every test works inside its own generated schema and nothing touches `public`,
# so this is safe to point at a real database. Set TEST_DATABASE_URL only when the
# test database should differ from the application one.
# TEST_DATABASE_URL=postgresql://user:pass@localhost:5432/relay_test
#
# TEST_DATABASE_SSL overrides DATABASE_SSL for the test connection only.
# TEST_DATABASE_SSL=disable

# AI Lead Intelligence & Outbound Automation - environment configuration
#
# Copy to .env for local development; run npm run db:migrate, then npm start.
# npm start loads .env via --env-file-if-exists; isolated test launchers do not.
#
# Put secrets here rather than on a command line, so they stay out of shell
# history and out of any transcript.
#
# In staging and production these are set as platform environment variables /
# secrets (Render dashboard, GitHub Actions secrets) and this file is only the
# reference for WHICH variables exist. Never commit a filled-in .env — `.env` is
# gitignored; `.env.example` is not, so keep real values out of this file.

# ---------------------------------------------------------------------------
# Runtime
# ---------------------------------------------------------------------------
# development (default) | staging | production
# staging and production additionally REQUIRE DATABASE_URL, force Secure session
# cookies, trust X-Forwarded-Proto, and switch logs to JSON.
NODE_ENV=development
PORT=3000
# Staging/production require an explicit HTTPS origin without path/query/userinfo.
# Local defaults to http://localhost:PORT; override for a separate Vite origin.
# PUBLIC_APP_ORIGIN=https://app.example.com
# Required for deployed auth admission: independently generated secret, 32..4096 bytes.
# Local/test use a fixed non-production-only key; never copy it into a deployment.
# AUTH_RATE_LIMIT_SECRET=

# ---------------------------------------------------------------------------
# Database
# ---------------------------------------------------------------------------
# Leave DATABASE_URL unset to use SQLite (local development and the test suite).
# DATABASE_FILE only applies to SQLite.
DATABASE_FILE=data/app.db

# Set DATABASE_URL to switch to PostgreSQL. Choose direct or session pooling
# for the persistent Node host based on network capability; see docs/DEPLOYMENT.md.
# DATABASE_URL=

# TLS is verified by default: certificate chain, selected hostname, minimum TLS1.2.
# DATABASE_SSL accepts enable/disable; disable is refused in staging/production.
# The URL must contain explicit host/database/user/password. Percent-encode URL
# credentials. Query/fragment overrides and all PG* environment variables are
# refused; use only the supported DATABASE_* settings below.
# DATABASE_SSL=enable
# NODE_TLS_REJECT_UNAUTHORIZED=0 is refused in staging/production; it also
# weakens other HTTPS transports and must never be used as a connection fix.
# Optional PEM CA bundle (max64KiB, at most16 CA certificates). Supply the actual
# multiline value through the platform secret manager; no arbitrary file path.
# DATABASE_SSL_CA=
# Pool1..100; each process owns a pool. Budget replicas and deployment overlap.
# DATABASE_MAX_CONNECTIONS=10
# Acquisition1..30000ms.
# DATABASE_CONNECTION_TIMEOUT_MS=10000
# Runtime statement1..30000ms; query1..60000ms and strictly greater than statement.
# DATABASE_STATEMENT_TIMEOUT_MS=15000
# DATABASE_QUERY_TIMEOUT_MS=20000
# Idle transaction1..60000ms; idle pool eviction is fixed10s; lock timeout fixed5s
# except bounded transaction-local overrides already defined by domain services.
# DATABASE_IDLE_TRANSACTION_TIMEOUT_MS=15000
#
# Runtime startup and db:status require an existing, current schema and never
# initialize it. db:migrate is the explicit schema-changing command.
#
# For staging/production, supply these only to the separate migration job, never
# to the web process. Database-only jobs do not require HTTP origin/auth secrets.
# Local migration may use DATABASE_URL/DATABASE_FILE; deployed migration must
# explicitly select MIGRATION_DATABASE_URL. Unset migration SSL/CA/acquisition/
# idle-transaction fields inherit their DATABASE_* counterpart; pool defaults1.
# Migration statement/query defaults are independent of runtime limits.
# MIGRATION_DATABASE_URL=
# MIGRATION_DATABASE_SSL=enable
# MIGRATION_DATABASE_SSL_CA=
# MIGRATION_DATABASE_MAX_CONNECTIONS=1
# MIGRATION_DATABASE_CONNECTION_TIMEOUT_MS=10000
# Migration statement1..300000ms; query1..330000ms and greater than statement.
# MIGRATION_DATABASE_STATEMENT_TIMEOUT_MS=120000
# MIGRATION_DATABASE_QUERY_TIMEOUT_MS=130000
# MIGRATION_DATABASE_IDLE_TRANSACTION_TIMEOUT_MS=15000
#
# Deployed origin/secure cookies/auth secret are validated by verify:deploy using
# exactly the config it opens. Local TLS tests do not certify the real host/role.

# ---------------------------------------------------------------------------
# Logging
# ---------------------------------------------------------------------------
# debug | info | warn | error   (default: debug locally, info when deployed)
# LOG_LEVEL=info
# json | text                   (default: json when deployed, text locally)
# LOG_FORMAT=json

# ---------------------------------------------------------------------------
# Security
# ---------------------------------------------------------------------------
# Trust X-Forwarded-Proto to decide whether a request arrived over HTTPS. Only
# enable where a proxy you control (Render, a load balancer) sets that header —
# a direct client could otherwise claim HTTPS and be issued a Secure cookie over
# plaintext. Defaults to on in staging/production, off locally.
# TRUST_PROXY=true
# Always mark session cookies Secure, regardless of how the request arrived.
# FORCE_SECURE_COOKIES=true
# Local simulation controls default off and cannot be enabled in staging/production.
# ENABLE_TEST_CONTROLS=false

# ---------------------------------------------------------------------------
# Background worker
# ---------------------------------------------------------------------------
# The in-process loop that executes approved outbound actions. Disable it on any
# instance that should only serve HTTP (for example if the worker is later split
# into its own Render service, so that two instances do not both execute).
# WORKER_ENABLED=true
# WORKER_INTERVAL_MS=5000
# Global SEND authorization gate, including manual/bulk/worker paths. Defaults
# true only locally/in tests and false when deployed. Workers/receipts/intelligence
# can run while sending is paused. Change across instances by controlled restart.
# OUTBOUND_DISPATCH_ENABLED=false

# ---------------------------------------------------------------------------
# AI provider (optional)
# ---------------------------------------------------------------------------
# Without these, Relay uses its deterministic local agents and stays fully
# functional. Supported: groq | openai | openrouter | ollama
# LLM_PROVIDER=groq
# LLM_MODEL=
# GROQ_API_KEY=
# OPENAI_API_KEY=
# OPENROUTER_API_KEY=

# ---------------------------------------------------------------------------
# Test-only
# ---------------------------------------------------------------------------
# npm test always launches an isolated SQLite child; it does not load .env.
# PostgreSQL requires a dedicated disposable database and explicit acknowledgment.
# No DATABASE_URL fallback; never use an application/customer database.
# TEST_DATABASE_URL=postgresql://user:pass@127.0.0.1:5432/relay_test
# TEST_DATABASE_DISPOSABLE=1
# TEST_DATABASE_SSL=disable
#
# Test URL query/fragment options are refused. The runner uses typed owned schema
# settings rather than URL options. TLS selection is independent of
# DATABASE_SSL. Each run owns a random schema namespace; interrupted runs leave
# only their own namespace for later inspection once all child processes stop.
#
# dev:e2e uses fresh :memory: SQLite and rejects inherited DB/provider settings.
# It sets ISOLATED_E2E_HARNESS=1 internally; do not set that flag in normal apps.
# verify:workflows requires this exact loopback harness capability before writes.

# Controlled current-email verification (optional until authorized provider QA).
# Use only operator-authorized, distinct delivery/rejection mailboxes; never
# ordinary customer addresses. Missing values keep probe creation unavailable.
# Provider credentials/signing policies remain managed in Settings > Email.
# EMAIL_VERIFICATION_DELIVERY_MAILBOX=
# EMAIL_VERIFICATION_FAILURE_MAILBOX=

# Local engineering UI only; hidden from customer navigation and unavailable in staging/production.
# Sign in as the local workspace owner, then open /developer-tools. This does not enable test callbacks.
ENABLE_DEVELOPER_TOOLS=false

# Vercel function runtime only; never use a VITE_ prefix for these secrets.
# FRONTEND_ORIGIN=https://your-approved-frontend.example
# BACKEND_ORIGIN=https://your-existing-backend.example
# Leave BACKEND_ORIGIN unset for a coming-soon frontend with independent intake.
# INTEREST_DATABASE_URL=postgresql://restricted_interest_login:ENCODED_PASSWORD@HOST:5432/postgres
# INTEREST_DATABASE_SSL_CA=<optional verified CA PEM>
# INTEREST_ADMISSION_SECRET=<independently generated secret of at least 32 characters>

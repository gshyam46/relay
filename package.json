{
  "name": "ai-lead-intelligence-outbound-automation",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "start": "node --env-file-if-exists=.env src/server.js",
    "lint": "node scripts/lint.js",
    "format:check": "node scripts/format-check.js",
    "dev:reset": "node --env-file-if-exists=.env scripts/dev-reset.js",
    "dev:seed:qa": "node --env-file-if-exists=.env scripts/dev-seed-qa.js",
    "smoke": "node scripts/smoke-api.js",
    "test": "node --test",
    "ci": "npm run lint && npm run format:check && npm test",
    "client:install": "npm --prefix client install",
    "client:build": "npm --prefix client run build",
    "db:migrate": "node --env-file-if-exists=.env scripts/db-migrate.js",
    "db:status": "node --env-file-if-exists=.env scripts/db-status.js",
    "dev:e2e": "node scripts/dev-e2e.js",
    "test:pg": "node --env-file-if-exists=.env scripts/run-postgres-tests.js",
    "verify:deploy": "node --env-file-if-exists=.env scripts/verify-deployment.js"
  },
  "engines": {
    "node": ">=24"
  },
  "dependencies": {
    "pg": "^8.23.0"
  }
}

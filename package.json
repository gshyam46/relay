{
  "name": "ai-lead-intelligence-outbound-automation",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "start": "node --env-file-if-exists=.env src/server.js",
    "lint": "node scripts/lint.js",
    "format:check": "node scripts/format-check.js",
    "dev:reset": "node --env-file-if-exists=.env scripts/dev-reset.js",
    "dev:seed:qa": "node --env-file-if-exists=.env scripts/dev-seed-qa.js",
    "smoke": "node scripts/smoke-api.js",
    "test": "node scripts/run-tests.js",
    "ci": "npm run lint && npm run format:check && npm test && npm run eval:intelligence -- --check",
    "client:install": "npm --prefix client install",
    "client:build": "npm --prefix client run build",
    "db:migrate": "node --env-file-if-exists=.env scripts/db-migrate.js",
    "db:status": "node --env-file-if-exists=.env scripts/db-status.js",
    "dev:e2e": "node scripts/dev-e2e.js",
    "test:pg": "node --env-file-if-exists=.env scripts/run-postgres-tests.js",
    "verify:deploy": "node --env-file-if-exists=.env scripts/verify-deployment.js",
    "verify:workflows": "node --env-file-if-exists=.env scripts/verify-workflows.js",
    "eval:intelligence": "node scripts/evaluate-intelligence.js",
    "verify:analysis-ui": "node scripts/run-analysis-ui.js",
    "verify:feedback-ui": "node scripts/run-feedback-ui.js",
    "verify:channel-setup-ui": "node scripts/run-channel-setup-ui.js",
    "verify:landing-ui": "node scripts/run-landing-ui.js",
    "verify:completion-ui": "node scripts/run-completion-ui.js",
    "verify:setup-journey-ui": "node scripts/run-setup-journey-ui.js",
    "db:backup": "node scripts/db-backup.js",
    "db:restore-drill": "node scripts/db-restore-drill.js",
    "db:schema-manifest": "node scripts/generate-schema-manifest.js",
    "pilot:interest": "node scripts/pilot-interest.js",
    "verify:intelligence-trust-ui": "node scripts/run-intelligence-trust-ui.js",
    "verify:operations": "node scripts/verify-operations.js",
    "verify:workspace-data-ui": "node scripts/run-workspace-data-ui.js",
    "verify:email-verification-ui": "node scripts/run-email-verification-ui.js",
    "verify:availability-ui": "node scripts/run-availability-ui.js",
    "interest:store": "node scripts/interest-store.js"
  },
  "engines": {
    "node": ">=24"
  },
  "dependencies": {
    "pg": "^8.23.0"
  }
}

{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": null,
  "installCommand": "npm ci && npm --prefix client ci --include=dev",
  "buildCommand": "npm --prefix client run build",
  "outputDirectory": "client/dist",
  "functions": {
    "api/gateway.js": {
      "maxDuration": 30
    }
  },
  "routes": [
    {
      "src": "/api(?:/(.*))?",
      "dest": "/api/gateway?route=$1",
      "headers": {
        "Cache-Control": "no-store"
      }
    },
    {
      "handle": "filesystem"
    },
    {
      "src": "/(login|register|recover|app|leads|imports|intelligence|outbound|conversations|workflows|event-recovery|activity|settings|developer-tools)(/.*)?",
      "dest": "/index.html",
      "headers": {
        "X-Robots-Tag": "noindex, nofollow",
        "Cache-Control": "no-store"
      }
    },
    {
      "src": "/(.*)",
      "dest": "/index.html"
    }
  ]
}
